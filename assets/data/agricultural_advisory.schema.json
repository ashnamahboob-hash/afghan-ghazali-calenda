{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashnamahboob-hash/afghan-ghazali-calenda/blob/feature/modern-calendar-agriculture-prayer/assets/data/agricultural_advisory.schema.json",
  "title": "Afghan Ghazali Calendar agricultural advisory dataset",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "country",
    "calendar_system",
    "source_policy",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "const": "AF-AGRI-ADVISORY"
    },
    "country": {
      "type": "string",
      "const": "AF"
    },
    "calendar_system": {
      "type": "string",
      "const": "afghan_solar_hijri"
    },
    "source_policy": {
      "type": "object",
      "required": [
        "minimum_sources_for_verified"
      ],
      "properties": {
        "minimum_sources_for_verified": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/advisory"
      }
    }
  },
  "$defs": {
    "localizedNames": {
      "type": "object",
      "required": [
        "ps",
        "fa",
        "en"
      ],
      "properties": {
        "ps": {
          "type": "string",
          "minLength": 1
        },
        "fa": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "solarDate": {
      "type": "object",
      "required": [
        "month",
        "day"
      ],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "organization",
        "url",
        "accessed_at"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "evidence_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "advisory": {
      "type": "object",
      "required": [
        "id",
        "crop_id",
        "crop_names",
        "province_id",
        "district_id",
        "activity",
        "season_id",
        "recommendation",
        "sources",
        "verification_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AF-AGRI-[A-Z0-9-]+$"
        },
        "crop_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "crop_names": {
          "$ref": "#/$defs/localizedNames"
        },
        "province_id": {
          "type": "string",
          "pattern": "^AF[0-9]{2}$"
        },
        "district_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^AF[0-9]{4}$"
        },
        "agroecological_zone_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "activity": {
          "type": "string",
          "enum": [
            "land_preparation",
            "sowing",
            "transplanting",
            "irrigation",
            "fertilizing",
            "weeding",
            "pest_monitoring",
            "harvest",
            "storage",
            "other"
          ]
        },
        "season_id": {
          "type": "string",
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter",
            "year_round"
          ]
        },
        "window": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "calendar",
            "start",
            "end"
          ],
          "properties": {
            "calendar": {
              "type": "string",
              "const": "afghan_solar_hijri"
            },
            "start": {
              "$ref": "#/$defs/solarDate"
            },
            "end": {
              "$ref": "#/$defs/solarDate"
            },
            "crosses_year_boundary": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "recommendation": {
          "$ref": "#/$defs/localizedNames"
        },
        "conditions": {
          "type": "object",
          "properties": {
            "irrigation": {
              "type": [
                "string",
                "null"
              ]
            },
            "soil": {
              "type": [
                "string",
                "null"
              ]
            },
            "altitude_m": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "uniqueItems": true
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "draft",
            "pending_review",
            "verified",
            "retired"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "properties": {
              "sources": {
                "minItems": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date"
              },
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewed_at",
              "reviewed_by"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
