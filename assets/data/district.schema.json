{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashnamahboob-hash/afghan-ghazali-calenda/blob/feature/modern-calendar-agriculture-prayer/assets/data/district.schema.json",
  "title": "Afghan Ghazali Calendar administrative district dataset",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "country",
    "province",
    "dataset_status",
    "source_policy",
    "fields",
    "districts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string"
    },
    "country": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "const": "AF"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "province": {
      "type": "object",
      "required": [
        "id",
        "names"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "names": {
          "$ref": "#/$defs/localizedNames"
        }
      },
      "additionalProperties": false
    },
    "dataset_status": {
      "type": "string",
      "enum": [
        "draft_pending_official_row_level_verification",
        "verified"
      ]
    },
    "source_policy": {
      "type": "object"
    },
    "fields": {
      "type": "object"
    },
    "districts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/district"
      }
    }
  },
  "$defs": {
    "localizedNames": {
      "type": "object",
      "required": [
        "ps",
        "fa",
        "en"
      ],
      "properties": {
        "ps": {
          "type": "string",
          "minLength": 1
        },
        "fa": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "district": {
      "type": "object",
      "required": [
        "id",
        "province_id",
        "names",
        "verification",
        "source_ids",
        "reviewed_at",
        "record_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AF[0-9]{4}$"
        },
        "province_id": {
          "type": "string",
          "pattern": "^AF[0-9]{2}$"
        },
        "names": {
          "$ref": "#/$defs/localizedNames"
        },
        "verification": {
          "type": "object",
          "required": [
            "pcode",
            "ps",
            "fa",
            "en"
          ],
          "properties": {
            "pcode": {
              "type": "string"
            },
            "ps": {
              "type": "string"
            },
            "fa": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "record_status": {
          "type": "string",
          "enum": [
            "pending_official_verification",
            "verified"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
